{
  "sideBarEnabled": true,
  "sideBarPosition": "left",
  "primaryAccent": "#ff51c5",
  "secondaryAccent": "#bb9af7",
  "barOpacity": 1.0,
  "menuIcon": "󰚌",
  "menuIconColor": "primary",
  "hudTitle": "MIDNIGHT-DOLL",
  "hudTitleColor": "secondary",
  "hudSubtitle": "HUD",
  "hudSubtitleColor": "primary",
  "hudCommand": "omarchy-launch-or-focus-tui btop",
  "hudMeters": {
    "cpu": true,
    "fan": true,
    "ram": true,
    "dsk": true,
    "conns": true,
    "net": true
  },
  "barActions": {
    "visualizer": {
      "click": "~/.config/omarchy/themes/midnight-doll/bin/launch-cliamp.sh",
      "rightClick": "~/.config/omarchy/themes/midnight-doll/bin/launch-audio-tool.sh",
      "scrollUp": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+",
      "scrollDown": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"
    },
    "sysHud": {
      "click": "omarchy-launch-or-focus-tui btop",
      "rightClick": "omarchy-launch-or-focus-tui --app-id=TUI.float ~/.config/omarchy/themes/midnight-doll/bin/launch-comms.sh",
      "scrollUp": "",
      "scrollDown": ""
    },
    "comms": {
      "click": "omarchy-launch-or-focus-tui --app-id=TUI.float ~/.config/omarchy/themes/midnight-doll/bin/launch-comms.sh",
      "rightClick": "",
      "scrollUp": "",
      "scrollDown": ""
    },
    "menu": {
      "click": "",
      "rightClick": "xdg-terminal-exec",
      "scrollUp": "",
      "scrollDown": ""
    },
    "clock": {
      "click": "",
      "rightClick": "",
      "scrollUp": "",
      "scrollDown": ""
    },
    "notifications": {
      "click": "",
      "rightClick": "",
      "scrollUp": "",
      "scrollDown": ""
    }
  }
}
