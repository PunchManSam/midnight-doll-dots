#!/usr/bin/env python3
import json
import os
import subprocess
import sys

STATE_DIR = os.path.expanduser("~/.local/state/omarchy")
BAR_OFF_FILE = os.path.join(STATE_DIR, "toggles/bar-off")
FS_STATE_FILE = os.path.join(STATE_DIR, "fullscreen-bars.json")

def get_hyprctl(cmd):
    try:
        out = subprocess.check_output(["hyprctl", "-j"] + cmd, text=True)
        return json.loads(out)
    except Exception:
        return None

def run_dispatch(lua_expr):
    subprocess.run(
        ["hyprctl", "repl", f"hl.dispatch({lua_expr})"],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )

def is_bar_hidden():
    return os.path.exists(BAR_OFF_FILE)

def set_bar_hidden(hidden):
    current = is_bar_hidden()
    if current != hidden:
        if hidden:
            os.makedirs(os.path.dirname(BAR_OFF_FILE), exist_ok=True)
            with open(BAR_OFF_FILE, "w"):
                pass
        else:
            try:
                os.remove(BAR_OFF_FILE)
            except OSError:
                pass
        subprocess.run(
            ["omarchy-shell", "-q", "omarchy.bar", "syncHidden"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )

def load_fs_state():
    if os.path.exists(FS_STATE_FILE):
        try:
            with open(FS_STATE_FILE, "r") as f:
                return json.load(f)
        except Exception:
            pass
    return {
        "desktop_bar_hidden": False,
        "manual_override_windows": [],
        "manual_override_workspaces": [],
        "fullscreen_active": False,
    }

def save_fs_state(state):
    os.makedirs(os.path.dirname(FS_STATE_FILE), exist_ok=True)
    try:
        tmp_file = FS_STATE_FILE + ".tmp"
        with open(tmp_file, "w") as f:
            json.dump(state, f)
        os.replace(tmp_file, FS_STATE_FILE)
    except Exception:
        pass

def get_active_workspace_and_windows():
    clients = get_hyprctl(["clients"])
    active_ws = get_hyprctl(["activeworkspace"])
    active_win = get_hyprctl(["activewindow"])
    return clients, active_ws, active_win

def get_fullscreen_window_on_active_ws(clients, active_ws, active_win=None):
    if not clients or not active_ws:
        return None
    ws_id = active_ws.get("id")

    # 1. Prefer active_win if it is on the active workspace and has fullscreen active
    if active_win and active_win.get("workspace", {}).get("id") == ws_id:
        fs = active_win.get("fullscreen", 0)
        if fs > 0:
            return active_win

    # 2. Check all clients on active workspace with fullscreen active
    for c in clients:
        if c.get("workspace", {}).get("id") == ws_id:
            fs = c.get("fullscreen", 0)
            if fs > 0:
                return c

    # 3. If Hyprland reports workspace hasfullscreen == True, check fullscreenClient fallback
    if active_ws.get("hasfullscreen", False):
        if active_win and active_win.get("workspace", {}).get("id") == ws_id:
            if active_win.get("fullscreenClient", 0) > 0:
                return active_win
        for c in clients:
            if c.get("workspace", {}).get("id") == ws_id:
                if c.get("fullscreenClient", 0) > 0:
                    return c

    return None

def sync():
    clients, active_ws, active_win = get_active_workspace_and_windows()
    if not clients or not active_ws:
        return

    state = load_fs_state()
    manual_windows = set(state.get("manual_override_windows", []))
    manual_workspaces = {
        int(w) for w in state.get("manual_override_workspaces", [])
        if isinstance(w, int) or (isinstance(w, str) and w.isdigit())
    }

    # Clean up stale addresses of closed windows
    existing_addrs = {c.get("address") for c in clients}
    manual_windows = manual_windows.intersection(existing_addrs)
    state["manual_override_windows"] = list(manual_windows)

    fs_win = get_fullscreen_window_on_active_ws(clients, active_ws, active_win)
    ws_id = active_ws.get("id")

    state["fullscreen_active"] = (fs_win is not None)
    state["fullscreen_address"] = fs_win.get("address", "") if fs_win else ""
    state["fullscreen_title"] = fs_win.get("title", "") if fs_win else ""
    state["fullscreen_workspace"] = ws_id

    if fs_win:
        addr = fs_win.get("address", "")
        fs = fs_win.get("fullscreen", 0)

        is_overridden = (addr in manual_windows) or (ws_id in manual_workspaces)

        if is_overridden:
            # Workspace or window has manual override to show bars over fullscreen
            manual_windows.add(addr)
            if ws_id is not None:
                manual_workspaces.add(ws_id)
            state["manual_override_windows"] = list(manual_windows)
            state["manual_override_workspaces"] = list(manual_workspaces)
            state["auto_hidden"] = False
            save_fs_state(state)

            if is_bar_hidden():
                set_bar_hidden(False)

            if fs != 1:
                run_dispatch(f"hl.dsp.window.fullscreen_state({{ window = 'address:{addr}', internal = 1, client = 2 }})")
        else:
            # Default behavior: fullscreen hides bars!
            if not is_bar_hidden():
                state["auto_hidden"] = True
                save_fs_state(state)
                set_bar_hidden(True)
            else:
                save_fs_state(state)

            if fs != 2:
                run_dispatch(f"hl.dsp.window.fullscreen_state({{ window = 'address:{addr}', internal = 2, client = 2 }})")
    else:
        # No fullscreen window on the active workspace
        if ws_id is not None and ws_id in manual_workspaces:
            manual_workspaces.discard(ws_id)
            state["manual_override_workspaces"] = list(manual_workspaces)

        was_auto_hidden = state.get("auto_hidden", False)
        desktop_hidden = state.get("desktop_bar_hidden", False)
        state["auto_hidden"] = False
        save_fs_state(state)
        # Restore bars only if they were auto-hidden by fullscreen and not explicitly hidden on desktop
        if was_auto_hidden and not desktop_hidden and is_bar_hidden():
            set_bar_hidden(False)

def toggle_window():
    clients, active_ws, active_win = get_active_workspace_and_windows()
    fs_win = get_fullscreen_window_on_active_ws(clients, active_ws, active_win)
    ws_id = active_ws.get("id") if active_ws else None

    state = load_fs_state()
    manual_windows = set(state.get("manual_override_windows", []))
    manual_workspaces = {
        int(w) for w in state.get("manual_override_workspaces", [])
        if isinstance(w, int) or (isinstance(w, str) and w.isdigit())
    }

    if fs_win:
        # A window is already fullscreen on this workspace -> EXIT fullscreen!
        addr = fs_win.get("address")
        if ws_id is not None:
            manual_workspaces.discard(ws_id)
            ws_addrs = {c.get("address") for c in clients if c.get("workspace", {}).get("id") == ws_id}
            manual_windows.difference_update(ws_addrs)
        if addr in manual_windows:
            manual_windows.remove(addr)

        state["manual_override_windows"] = list(manual_windows)
        state["manual_override_workspaces"] = list(manual_workspaces)

        was_auto_hidden = state.get("auto_hidden", False)
        desktop_hidden = state.get("desktop_bar_hidden", False)
        state["auto_hidden"] = False
        state["fullscreen_active"] = False
        state["fullscreen_address"] = ""
        state["fullscreen_title"] = ""
        state["fullscreen_workspace"] = ws_id
        save_fs_state(state)

        run_dispatch(f"hl.dsp.window.fullscreen_state({{ window = 'address:{addr}', internal = 0, client = 0 }})")

        # Restore bars if they were auto-hidden by fullscreen and not explicitly hidden on desktop
        if was_auto_hidden and not desktop_hidden and is_bar_hidden():
            set_bar_hidden(False)
    else:
        # No window is fullscreen on this workspace -> ENTER fullscreen on active_win!
        if not active_win or not active_win.get("address"):
            return
        addr = active_win.get("address")

        if ws_id is not None:
            manual_workspaces.discard(ws_id)
        if addr in manual_windows:
            manual_windows.remove(addr)
        state["manual_override_windows"] = list(manual_windows)
        state["manual_override_workspaces"] = list(manual_workspaces)

        already_hidden = is_bar_hidden()
        state["desktop_bar_hidden"] = already_hidden
        state["auto_hidden"] = not already_hidden
        state["fullscreen_active"] = True
        state["fullscreen_address"] = addr
        state["fullscreen_title"] = active_win.get("title", "")
        state["fullscreen_workspace"] = ws_id
        save_fs_state(state)

        if not already_hidden:
            set_bar_hidden(True)

        # Full edge-to-edge
        run_dispatch(f"hl.dsp.window.fullscreen_state({{ window = 'address:{addr}', internal = 2, client = 2 }})")

def toggle_bar():
    clients, active_ws, active_win = get_active_workspace_and_windows()
    fs_win = get_fullscreen_window_on_active_ws(clients, active_ws, active_win)
    ws_id = active_ws.get("id") if active_ws else None

    state = load_fs_state()
    manual_windows = set(state.get("manual_override_windows", []))
    manual_workspaces = {
        int(w) for w in state.get("manual_override_workspaces", [])
        if isinstance(w, int) or (isinstance(w, str) and w.isdigit())
    }

    new_hidden = not is_bar_hidden()

    state["fullscreen_active"] = (fs_win is not None)
    state["fullscreen_address"] = fs_win.get("address", "") if fs_win else ""
    state["fullscreen_title"] = fs_win.get("title", "") if fs_win else ""
    state["fullscreen_workspace"] = ws_id
    state["auto_hidden"] = False

    if fs_win:
        addr = fs_win.get("address", "")
        if not new_hidden:
            # Key combo was pressed to SHOW bars over fullscreen
            if addr:
                manual_windows.add(addr)
            if ws_id is not None:
                manual_workspaces.add(ws_id)
        else:
            # Key combo was pressed to HIDE bars over fullscreen
            if ws_id is not None:
                manual_workspaces.discard(ws_id)
                ws_addrs = {c.get("address") for c in clients if c.get("workspace", {}).get("id") == ws_id}
                manual_windows.difference_update(ws_addrs)
            if addr:
                manual_windows.discard(addr)
    else:
        state["desktop_bar_hidden"] = new_hidden

    state["manual_override_windows"] = list(manual_windows)
    state["manual_override_workspaces"] = list(manual_workspaces)
    save_fs_state(state)
    set_bar_hidden(new_hidden)

    if fs_win:
        addr = fs_win.get("address", "")
        if addr:
            if not new_hidden:
                # Key combo was pressed to SHOW bars over fullscreen
                run_dispatch(f"hl.dsp.window.fullscreen_state({{ window = 'address:{addr}', internal = 1, client = 2 }})")
            else:
                # Key combo was pressed to HIDE bars
                run_dispatch(f"hl.dsp.window.fullscreen_state({{ window = 'address:{addr}', internal = 2, client = 2 }})")

if __name__ == "__main__":
    if len(sys.argv) > 1 and sys.argv[1] == "--toggle-window":
        toggle_window()
    elif len(sys.argv) > 1 and sys.argv[1] == "--toggle-bar":
        toggle_bar()
    else:
        sync()
